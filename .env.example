# cp .env.example .env 한 뒤 값을 채운다. .env는 git에 올라가지 않는다(.gitignore).

# 화면 포트(8000을 다른 프로그램이 쓰면 바꾼다)
CREW_PORT=8000

# 실행 방식: fake(키 없음·결정적) | live(내 OpenAI 키) | replay(녹화 재생, 0원) | record(live로 돌리며 녹화) | local(OpenAI 호환 주소: LM Studio·AWS Bedrock)
LLM_MODE=fake

# live/record에서만 필요. 강의용 프로젝트의 Restricted 키를 쓴다(1-4).
OPENAI_API_KEY=
CREW_MODEL=gpt-5-mini

# local: OpenAI 호환 주소(Chat Completions). 아래 둘 중 하나를 쓴다
# LM Studio(키 필요 없음)
LOCAL_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_MODEL=local-model
# AWS Bedrock 예시(값은 자리표시. <region>과 키를 내 것으로 바꾼다)
# LOCAL_BASE_URL=https://bedrock-runtime.<region>.amazonaws.com/openai/v1
# LOCAL_MODEL=openai.gpt-oss-20b-1:0
# LOCAL_API_KEY=<내 Bedrock API 키>
# gpt-oss가 답 앞에 붙이는 <reasoning>…</reasoning>은 랩이 걷어 낸다(crew/runtime/llm.py).
# Moderation API·openai-guardrails·Traces는 OpenAI 전용이라 LLM_MODE=live와 OpenAI 키가 필요하다.

# 요금 차단기: 이번 랩 누적 비용이 넘으면 다음 호출을 거부한다
LAB_MAX_USD=1.00
# 1M 토큰당 달러(녹화 전에 OpenAI 가격표로 다시 맞춘다)
CREW_PRICE_IN=0.25
CREW_PRICE_OUT=2.00

# OpenAI 트레이싱: live에서 기본 켜짐(SDK 기본값). 4-5에서 다룬다
CREW_TRACING=on
